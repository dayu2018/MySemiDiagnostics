<Window x:Class="MySemiDiagnostics.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MySemiDiagnostics.Shell"
        mc:Ignorable="d"
        Title="半导体检测设备诊断系统" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <Menu Grid.Row="0">
            <MenuItem Header="文件">
                <MenuItem Header="退出" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="诊断">
                <MenuItem Header="运动系统"/>
                <MenuItem Header="视觉系统"/>
            </MenuItem>
            <MenuItem Header="设置">
                <MenuItem Header="参数配置" Click="Settings_Click"/>
            </MenuItem>
        </Menu>
        
        <TabControl Grid.Row="1" Margin="5">
            <TabItem Header="运动控制">
                <TextBlock Text="运动控制模块" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>
            <TabItem Header="视觉检测">
                <TextBlock Text="视觉检测模块" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </TabItem>
        </TabControl>
        
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="就绪"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
